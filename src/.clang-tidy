# clang-tidy configuration for wireguard-tools — bug-finding gate.
#
# Enabled: the Clang Static Analyzer (clang-analyzer-*) plus the genuine
# bug-finding families bugprone-*, cert-*, misc-*, performance-*, portability-*.
# All findings from these are fixed in the code; WarningsAsErrors fails CI on
# any new one.
#
# misc-include-cleaner is DISABLED (the sole disabled check): it is an
# include-what-you-use checker that fights this codebase's intentional header
# abstraction — containers.h re-exports kernel constants (e.g. WG_KEY_LEN) and
# the kernel UAPI header is selected per-platform via uapi/$(PLATFORM). Its
# "fixes" add <linux/wireguard.h>, <asm-generic/*>, <features.h> to
# platform-agnostic translation units (encoding.c, config.c, genkey.c) and
# remove needed headers, breaking cross-platform builds. See docs/PROJECT.md
# and .claude/rules/project.md (CROSS-PLATFORM BUILDS MUST NOT BREAK).
#
# Two correct-but-flagged idiom sites are muted inline with justification
# (NOLINT), not disabled globally, so new code is still checked:
#   config.c key_match() assign-and-test dispatch (assignment-in-if-condition)
#   config.c parse_fwmark two same-type out-params (easily-swappable-parameters)
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  misc-*,
  performance-*,
  portability-*,
  -misc-include-cleaner
HeaderFilterRegex: '(config|ipc|ipc-uapi|ipc-uapi-unix|ipc-linux|containers|encoding|ctype|terminal|subcommands|curve25519)\.h$'
WarningsAsErrors: '*'
